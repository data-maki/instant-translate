SONIOX_API_KEY=your_soniox_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
# Optional override for POST /context/name-katakana (profile page).
# OPENAI_NAME_KATAKANA_MODEL=gpt-4o-mini
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPL_API_KEY=your_deepl_api_key_here
DEEPL_FORMALITY=
DEEPL_GLOSSARY_ID=
GROQ_API_KEY=your_groq_api_key_here
GROQ_REWRITE_MODEL=qwen/qwen3-32b
# Session titles use Groq when configured, otherwise OpenAI.
GROQ_SESSION_TITLE_MODEL=openai/gpt-oss-20b
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Frontend defaults to http://localhost:8000 if unset.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Backend must resolve web credentials through the matching frontend.
AUTH_BASE_URL=http://localhost:3000

# Simple auth credentials used by the Next.js auth route.
EMAIL=you@example.com
PASSWORD=change-me

# Internal mobile builds can use the API without a login.
ALLOW_AUTHLESS_INTERNAL=0
INTERNAL_USER_ID=internal-mobile

# Optional independent voice check after recording (see docs/speaker-identification.md).
# Defaults to ~/.cache/cottonoha/speakers/wespeaker_en_voxceleb_resnet34_LM.onnx.
SPEAKER_EMBEDDING_MODEL=
